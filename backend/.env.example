# ==============================================================================
# SHRI SEERVI SAMAJ KONDA — BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase Database & Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# JWT Authentication & Session Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters
JWT_REFRESH_EXPIRE=30d
COOKIE_SECRET=your_secure_cookie_secret_key

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Notification Service (SMTP - Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="Shri Seervi Samaj Konda <shriiseervisamajkonda@gmail.com>"

# Razorpay Donations Payment Gateway (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
